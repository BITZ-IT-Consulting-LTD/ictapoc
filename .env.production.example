# PostgreSQL
POSTGRES_DB=gov_service_db
POSTGRES_USER=gov_service_user
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Django
SECRET_KEY=REPLACE_WITH_AT_LEAST_50_RANDOM_CHARACTERS
JWT_SECRET_KEY=REPLACE_WITH_A_SEPARATE_LONG_RANDOM_VALUE
DEBUG=False
ALLOWED_HOSTS=gokservices.bitz-itc.com,localhost,127.0.0.1,backend

# Redis / Celery
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD

# Production operations
LOG_LEVEL=info
USE_X_ACCEL_REDIRECT=True
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
